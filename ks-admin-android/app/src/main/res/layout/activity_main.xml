<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07111D">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KS AVIATION"
            android:textColor="#9FB0C4"
            android:textSize="14sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hızlı İş Bitirici"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="28sp"
            android:layout_marginBottom="20dp"/>

        <EditText
            android:id="@+id/pin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="6 haneli yönetici PIN"
            android:inputType="numberPassword"
            android:maxLength="6"
            android:textColor="#FFFFFF"
            android:textColorHint="#8294A8"
            android:backgroundTint="#22C55E"/>

        <Button
            android:id="@+id/connect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bağlan ve Servisi Başlat"
            android:layout_marginTop="12dp"/>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bağlı değil"
            android:textColor="#FCA5A5"
            android:textSize="16sp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"/>

        <TextView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bekleyen talep yok."
            android:textColor="#FFFFFF"
            android:textSize="16sp"/>
    </LinearLayout>
</ScrollView>
